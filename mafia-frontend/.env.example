# Backend API Base URL (defaults to http://localhost:8080 if omitted)
VITE_API_BASE_URL=http://localhost:8080

# Google OAuth 2.0 Client Credentials
# Create a project in Google Cloud Console, set up OAuth, and create a Web Client ID
# Set Authorized JavaScript Origins to: http://localhost:5173 (and your production URL)
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id-here.apps.googleusercontent.com
